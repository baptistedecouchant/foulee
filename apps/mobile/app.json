{
  "expo": {
    "name": "Foulée",
    "slug": "foulee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "foulee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.foulee.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSHealthShareUsageDescription": "Foulée lit tes séances de course enregistrées par ta montre pour valider ton plan et créditer tes points.",
        "NSHealthUpdateUsageDescription": "Foulée n'écrit pas de données dans Santé.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Foulée utilise ta position pendant une séance pour mesurer ton allure et ta distance, et te guider à la voix."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#2747F5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.foulee.mobile",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2747F5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Foulée utilise ta position pendant une séance pour mesurer ton allure et ta distance, et te guider à la voix.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "Foulée lit tes séances de course et ton nombre de pas pour valider ton plan et créditer tes RunCoins.",
          "NSHealthUpdateUsageDescription": false,
          "background": false
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511",
          "userTrackingUsageDescription": "Permet d’afficher des publicités plus pertinentes. Tu peux refuser, les récompenses restent les mêmes."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "0ac2c357-42e0-4808-a2bf-d48911475fca"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/0ac2c357-42e0-4808-a2bf-d48911475fca"
    },
    "runtimeVersion": {
      "policy": "sdkVersion"
    }
  }
}
